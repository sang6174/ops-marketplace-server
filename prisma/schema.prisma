// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  BUYER
  SELLER
  SHIPPER
}

enum SubAdminRole {
  SUPER_ADMIN
  TECHNICIAN
  WAREHOUSE_MANAGER
  FINANCE_STAFF
  CONTENT_MANAGER
  CUSTOMER_SUPPORT
}

enum BuyerType {
  INDIVIDUAL
  WHOLESALER
  BUSINESS
}

enum VehicleType {
  MOTORBIKE
  VAN
  TRUCK
  COLD_TRUCK
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ProductCategory {
  FRUITS
  VEGETABLES
  GRAINS
  DAIRY
  MEAT
  SEAFOOD
  BEVERAGES
  OTHER
}

enum ProductUnit {
  KG
  GRAM
  TON
  LITER
  ML
  PIECE
  DOZEN
  LOT
  BOX
  BUNCH
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderType {
  RETAIL
  WHOLESALE
  PRE_ORDER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  STRIPE
  MOMO
  BANK_TRANSFER
  COD
  ONLINE
}

enum PayoutMethod {
  BANK_TRANSFER
  STRIPE
  MOMO
  CASH
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationChannel {
  INTERNAL
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  SYSTEM_ALERT
  MAINTENANCE
  UPDATE
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  LOW_STOCK
  OUT_OF_STOCK
  RESTOCKED
  ACCOUNT_VERIFIED
  ACCOUNT_SUSPENDED
  PASSWORD_RESET
  LOGIN_ALERT
  SELLER_APPROVED
  SELLER_REJECTED
  NEW_ORDER
  NEW_REVIEW
  ORDER_STATUS_UPDATE
  SHIPPING_UPDATE
  PROMOTION
  COUPON_EXPIRING
  CUSTOM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CartStatus {
  ACTIVE
  CHECKING_OUT
  COMPLETED
  EXPIRED
  ABANDONED
}

enum PaymentProvider {
  STRIPE
  MOMO
  PAYPAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum LedgerAccountType {
  PLATFORM_MAIN
  PLATFORM_FEE
  BUYER_WALLET
  SELLER_BALANCE
  SELLER_AVAILABLE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerEntryCategory {
  PAYMENT
  PAYOUT
  REFUND
  FEE
  ADJUSTMENT
}

// ============================================================
// MODELS
// ============================================================

// ===== BANK ACCOUNT =====
model BankAccount {
  id          String  @id @default(uuid())
  userId      String
  bankName    String
  accountNo   String
  accountName String
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bank_accounts")
}

// ===== USER & AUTH =====
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phoneNumber   String?        @unique
  password      String?
  name          String
  status        AccountStatus  @default(PENDING)
  isActive      Boolean        @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles         UserRoleMapping[]
  passwordResets   PasswordReset[]
  sessions      Session[]
  addresses     Address[]
  shop             Shop?
  sellerProducts   Product[]      @relation("SellerProducts")
  refunds          Refund[]
  reviews          Review[]
  buyingRooms      ChatRoom[]     @relation("Buyer")
  sellingRooms     ChatRoom[]     @relation("Seller")
  messages         Message[]
  ledgerAccounts   LedgerAccount[]
  cart          Cart?
  bankAccounts  BankAccount[]
  payouts       Payout[]
  payments      Payment[]
  notifications Notification[]
  orders        Order[]        @relation("BuyerOrders")
  sellerOrders  Order[]        @relation("SellerOrders")
  sellerProfile SellerProfile?
  buyerProfile  BuyerProfile?
  adminProfile  AdminProfile?
  shipperProfile ShipperProfile?

  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model UserRoleMapping {
  userId String
  role   UserRole

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([role, permissionId])
  @@map("role_permissions")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ===== PROFILES =====

model SellerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  farmName        String
  taxId           String?
  businessLicense String?
  bankAccount     String?
  isVerified      Boolean  @default(false)
  rating          Float?   @default(0)
  addresses       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("seller_profiles")
}

model BuyerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  buyerType       BuyerType @default(INDIVIDUAL)
  loyaltyPoints   Int      @default(0)
  taxId           String?
  companyName     String?
  businessLicense String?
  addresses       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("buyer_profiles")
}

model AdminProfile {
  id      String        @id @default(uuid())
  userId  String        @unique
  subRole SubAdminRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("admin_profiles")
}

model ShipperProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  vehicleType       VehicleType
  licensePlate      String
  driverLicense     String
  vehicleDescription String?
  operatingAreas    Json?
  isAvailable       Boolean       @default(true)
  currentLocation   Json?
  rating            Float?
  totalDeliveries   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  shipments Shipment[]

  @@map("shipper_profiles")
}

// ===== ADDRESS =====

model Address {
  id        String  @id @default(uuid())
  userId    String
  country   String?
  city      String?
  district  String?
  ward      String?
  street    String?
  postalCode String?
  detail    String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@index([userId, isDefault])
  @@map("addresses")
}

// ===== SHOP =====

model Shop {
  id          String  @id @default(uuid())
  ownerId     String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  owner    User        @relation(fields: [ownerId], references: [id])
  products Product[]
  refunds  Refund[]
  orderItems OrderItem[]

  @@index([ownerId, deletedAt])
  @@map("shops")
}

// ===== CATEGORY =====

model Category {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  path      String
  level     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  productCategoryMappings ProductCategoryMapping[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

// ===== PRODUCT =====

model Product {
  id               String          @id @default(uuid())
  shopId           String
  sellerId         String

  // Core fields
  name             String
  slug             String          @unique
  description      String?
  category         ProductCategory
  unit             ProductUnit
  status           ProductStatus   @default(DRAFT)

  // Pricing
  retailPrice      Decimal         @db.Decimal(12, 2)
  wholesalePrice   Decimal?        @db.Decimal(12, 2)
  minWholesaleQty  Int?

  // Additional info
  origin           String?
  isSeasonal       Boolean         @default(false)
  seasonStart      DateTime?
  seasonEnd        DateTime?

  // Sorting & display
  isFeatured       Boolean         @default(false)
  sortOrder        Int             @default(0)

  // Timestamps
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  // Relations
  shop   Shop @relation(fields: [shopId], references: [id])
  seller User @relation("SellerProducts", fields: [sellerId], references: [id])
  inventory        Inventory?
  certifications   ProductCertification[]
  images           ProductImage[]
  categories       ProductCategoryMapping[]
  reviews          Review[]
  stats            ProductStats?
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([shopId, status, deletedAt])
  @@index([sellerId, status, deletedAt])
  @@index([slug])
  @@index([status, deletedAt])
  @@map("products")
}

model ProductCertification {
  id           String @id @default(uuid())
  productId    String
  certification String

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, certification])
  @@map("product_certifications")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductStats {
  productId    String   @id
  minPrice     Decimal? @db.Decimal(12, 2)
  maxPrice     Decimal? @db.Decimal(12, 2)
  avgRating    Float?
  totalReviews Int      @default(0)

  product      Product  @relation(fields: [productId], references: [id])

  @@map("product_stats")
}

// ===== INVENTORY =====

model Inventory {
  productId         String   @id
  stock             Int
  reserved          Int      @default(0)
  sold              Int      @default(0)
  minStockThreshold Int      @default(10)
  lastRestockedAt   DateTime @default(now())
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt

  product           Product  @relation(fields: [productId], references: [id])

  @@map("inventories")
}

// ===== PRODUCT CATEGORY RELATION =====

model ProductCategoryMapping {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("product_category_mappings")
}

// ===== CART =====

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  user  User?     @relation(fields: [userId], references: [id])
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ===== ORDER =====

model Order {
  id            String       @id @default(uuid())
  buyerId       String
  sellerId      String
  orderType     OrderType    @default(RETAIL)
  status        OrderStatus  @default(PENDING)
  totalPrice    Decimal      @db.Decimal(12, 2)
  shippingAddress Json
  paymentMethod String
  paymentIntentId String?
  paymentStatus  PaymentStatus @default(PENDING)
  notes          String?

  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller User @relation("SellerOrders", fields: [sellerId], references: [id])
  items OrderItem[]
  payments PaymentItem[]
  refunds Refund[]
  shipments Shipment[]

  @@index([buyerId, status, deletedAt])
  @@index([sellerId, status, deletedAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([paymentStatus, deletedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  shopId         String
  productId      String
  price          Decimal  @db.Decimal(12, 2)
  quantity       Int
  productName    String
  productImage   String?
  attributes     Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  order          Order    @relation(fields: [orderId], references: [id])
  shop           Shop     @relation(fields: [shopId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([shopId])
  @@map("order_items")
}

// ===== PAYMENT =====

model Payment {
  id             String        @id @default(uuid())
  userId         String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("VND")
  status         PaymentStatus
  method         PaymentMethod
  provider       PaymentProvider?
  providerRef    String?       @unique
  idempotencyKey String?       @unique
  metadata       Json?
  paidAt         DateTime?
  refundedAt     DateTime?
  errorMessage   String?
  refundReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user  User        @relation(fields: [userId], references: [id])
  items PaymentItem[]

  @@index([userId, status, deletedAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("payments")
}

model PaymentItem {
  id        String @id @default(uuid())
  paymentId String
  orderId   String
  amount    Decimal @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([paymentId, orderId])
  @@map("payment_items")
}

// ===== REFUND =====

model Refund {
  id             String @id @default(uuid())
  userId         String
  orderId        String
  shopId         String
  amount         Decimal @db.Decimal(12, 2)
  reason         String?
  status         RefundStatus @default(REQUESTED)
  rejectedReason String?
  processedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  shop  Shop  @relation(fields: [shopId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId, status, deletedAt])
  @@index([shopId, status, deletedAt])
  @@map("refunds")
}

// ===== SHIPMENT =====

model Shipment {
  id          String         @id @default(uuid())
  orderId     String
  shopId      String
  shipperId   String?
  status      ShipmentStatus @default(PENDING)
  trackingNumber String?
  pickupAddress Json
  deliveryAddress Json
  estimatedDeliveryAt DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  order   Order           @relation(fields: [orderId], references: [id])
  shipper ShipperProfile? @relation(fields: [shipperId], references: [id])

  @@index([orderId])
  @@index([shipperId, status])
  @@index([status, createdAt])
  @@map("shipments")
}

// ===== PAYOUT =====

model Payout {
  id        String       @id @default(uuid())
  userId    String
  amount    Decimal      @db.Decimal(14, 2)
  status    PayoutStatus
  method    PayoutMethod?
  reference String?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
  @@map("payouts")
}

// ===== NOTIFICATION =====

model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  status    NotificationStatus   @default(PENDING)
  priority  NotificationPriority @default(NORMAL)
  channels  NotificationChannel[]
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ===== REVIEW =====

model Review {
  id        String  @id @default(uuid())
  userId    String?
  productId String
  rating    Int
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user    User?   @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, deletedAt])
  @@map("reviews")
}

// ===== CHAT =====

model ChatRoom {
  id       String @id @default(uuid())
  buyerId  String
  sellerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  buyer  User @relation("Buyer", fields: [buyerId], references: [id])
  seller User @relation("Seller", fields: [sellerId], references: [id])
  messages Message[]

  @@unique([buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("chat_rooms")
}

model Message {
  id       String  @id @default(uuid())
  roomId   String
  senderId String
  content  String
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ===== LEDGER =====

model LedgerAccount {
  id      String            @id @default(uuid())
  ownerId String?
  type    LedgerAccountType

  balance Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  deletedAt DateTime?

  owner User? @relation(fields: [ownerId], references: [id])
  entries LedgerEntry[]

  @@unique([ownerId, type])
  @@index([ownerId, type])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String              @id @default(uuid())
  accountId     String
  amount        Decimal             @db.Decimal(14, 2)
  type          LedgerEntryType
  reference     String
  transactionId String
  category      LedgerEntryCategory

  createdAt DateTime @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, transactionId, category])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ===== AUDIT LOG =====

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  actorId   String?
  actorType String?
  before    Json?
  after     Json?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}